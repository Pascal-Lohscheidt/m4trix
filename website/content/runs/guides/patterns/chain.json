      "channels": ["main"],
      "by": null,
      "cause": null,
      "payload": {
        "text": "What changed in the last release?"
      },
      "deliveredTo": ["planner"],
      "line": 46
    },
    {
      "i": 1,
      "name": "plan",
      "channels": ["plans"],
      "by": "planner",
      "cause": 0,
      "payload": {
        "steps": ["search \"What changed in the last release?\"", "summarize"]
      },
