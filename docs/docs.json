{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "m4trix",
  "description": "A TypeScript toolkit for building AI-driven web applications.",
  "colors": {
    "primary": "#7c3aed",
    "light": "#a78bfa",
    "dark": "#6d28d9"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#f8f8fb",
      "dark": "#09090b"
    }
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Lexend"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "thumbnails": {
    "appearance": "dark"
  },
