{
  "name": "core",
  "version": "0.0.0",
  "type": "module",
  "description": "This is root package.json for the @m4trix/core monorepo.",
  "packageManager": "pnpm@9.0.0",
  "author": "Pascal Lohscheidt",
  "license": "MIT",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "audit": "pnpm audit --audit-level high --ignore-registry-errors",
    "get:turbo": "npm install -g turbo",
    "test": "vitest --typecheck",
    "test:coverage": "vitest run --coverage",
    "package:build": "turbo run @m4trix/core#build",
    "package:publish": "turbo run @m4trix/core#publish-package",
    "evals:build": "turbo run @m4trix/evals#build",
    "evals:publish": "turbo run @m4trix/evals#publish-package",
    "stream:build": "turbo run @m4trix/stream#build",
    "stream:publish": "turbo run @m4trix/stream#publish-package",
    "react:build": "turbo run @m4trix/react#build",
    "react:publish": "turbo run @m4trix/react#publish-package",
    "tracing:build": "turbo run @m4trix/tracing#build",
    "tracing:publish": "turbo run @m4trix/tracing#publish-package",
    "trace-viewer:build": "turbo run @m4trix/trace-viewer#build",
    "trace-viewer:publish": "turbo run @m4trix/trace-viewer#publish-package",
    "ui:build": "turbo run @m4trix/ui#build",
    "ui:publish": "turbo run @m4trix/ui#publish-package",
    "release:check:core": "jiti scripts/check-package-scope.ts core",
    "release:check:evals": "jiti scripts/check-package-scope.ts evals",
    "release:check:stream": "jiti scripts/check-package-scope.ts stream",
    "release:check:react": "jiti scripts/check-package-scope.ts react",
    "release:check:tracing": "jiti scripts/check-package-scope.ts tracing",
    "release:check:trace-viewer": "jiti scripts/check-package-scope.ts trace-viewer",
    "release:check:ui": "jiti scripts/check-package-scope.ts ui",
    "release:bump:core": "jiti scripts/bump-and-tag.ts core",
    "release:bump:evals": "jiti scripts/bump-and-tag.ts evals",
    "release:bump:stream": "jiti scripts/bump-and-tag.ts stream",
    "release:bump:react": "jiti scripts/bump-and-tag.ts react",
    "release:bump:tracing": "jiti scripts/bump-and-tag.ts tracing",
    "release:bump:trace-viewer": "jiti scripts/bump-and-tag.ts trace-viewer",
    "release:bump:ui": "jiti scripts/bump-and-tag.ts ui",
    "changelog": "jiti scripts/generate-changelogs.ts",
    "changelog:commit": "jiti scripts/generate-changelogs.ts --commit"
  },
  "devDependencies": {
    "@m4trix/trace-viewer": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@biomejs/biome": "^2.4.6",
    "jsdom": "^26.1.0",
    "turbo": "^2.9.14",
    "vitest": "^4.0.0",
    "jiti": "^1.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.23.0",
      "axios": ">=1.15.2",
      "form-data": ">=4.0.4",
      "protobufjs": ">=7.5.6",
      "socket.io-parser": ">=4.2.6",
      "playwright": ">=1.55.1",
      "jws": ">=3.2.3",
      "lodash": ">=4.18.0",
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "langsmith": ">=0.6.0",
      "langchain": ">=0.3.37",
      "website>react": "18.3.1",
      "website>react-dom": "18.3.1",
      "@m4trix/trace-viewer>react": "19.1.0",
      "@m4trix/trace-viewer>react-dom": "19.1.0",
      "@m4trix/react>react": "19.1.0",
      "@m4trix/react>react-dom": "19.1.0",
      "@m4trix/evals>react": "19.1.0",
      "core-example>react": "19.2.3",
      "core-example>react-dom": "19.2.3",
      "@repo/open-ai-speech-to-speech-example>react": "19.1.0",
      "@repo/open-ai-speech-to-speech-example>react-dom": "19.1.0",
      "@repo/ui-integration-example>react": "19.1.0",
      "@repo/ui-integration-example>react-dom": "19.1.0"
    }
  }
}
