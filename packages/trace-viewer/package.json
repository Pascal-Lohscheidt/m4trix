{
  "name": "@m4trix/trace-viewer",
  "version": "0.7.0",
  "description": "Filesystem-backed trace viewer CLI with tRPC API and React UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "m4trix-trace-viewer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup && vite build",
    "build:client": "vite build",
    "build:server": "tsup",
    "dev": "vite --host 127.0.0.1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "npm run build",
    "publish-package": "pnpm publish --no-git-checks",
    "release": "pnpm -C ../.. run release:bump:trace-viewer",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@m4trix/tracing": "^0.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/lib-dynamodb": "^3.1053.0",
    "@headlessui/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@m4trix/tracing": "workspace:^",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.19.40",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.4",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.2",
    "vitest": "^3.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pascal-Lohscheidt/m4trix.git"
  },
  "bugs": {
    "url": "https://github.com/Pascal-Lohscheidt/m4trix/issues"
  },
  "homepage": "https://github.com/Pascal-Lohscheidt/m4trix#readme"
}
